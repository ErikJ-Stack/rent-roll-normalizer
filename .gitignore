.venv/
__pycache__/
.claude/
# Local-only test fixtures — contain real property financials. Never commit.
Sample Files/
# MF (multifamily) sample docs — real property financials (Hidden Lakes RR /
# T12 / AR / OM). Same rule as Sample Files/: never commit.
MF Docs/
# RR pipeline outputs — analyst-specific, not source data. The RR Normalizer
# writes files matching this pattern; they don't belong in the repo.
*Normalized [0-9]*.xlsx
# Streamlit local secrets — auth password hashes live here for local dev.
# Cloud secrets are configured via share.streamlit.io and never enter the repo.
.streamlit/secrets.toml
# macOS Finder noise.
.DS_Store
# Local backups of the bundled Analyzer (the canonical file lives at
# ALF_Financial_Analyzer_Only.xlsx — duplicates are working copies).
ALF_Financial_Analyzer_Only - Copy*.xlsx
ALF_Financial_Analyzer_Only - Backup*.xlsx

# T12 mapping memory (contains real operator GL descriptions; machine-local)
t12_mapping_memory.json
